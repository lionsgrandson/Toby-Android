<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F5F7F4">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <ImageView android:layout_width="64dp" android:layout_height="64dp"
            android:src="@drawable/toby_icon" android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="36sp" android:textStyle="bold" android:textColor="#153D42" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/tagline" android:textSize="16sp" android:layout_marginBottom="24dp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/ready" android:accessibilityLiveRegion="polite" android:textColor="#216C73" />
        <TextView android:id="@+id/request" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="16dp" android:freezesText="true" />
        <TextView android:id="@+id/response" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/welcome" android:textSize="20sp" android:paddingTop="12dp"
            android:paddingBottom="20dp" android:textIsSelectable="true" android:freezesText="true" />
        <EditText android:id="@+id/command" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:hint="@string/command_hint" android:inputType="textCapSentences"
            android:imeOptions="actionSend" android:maxLines="3" android:autofillHints="" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/send" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/send" />
            <Button android:id="@+id/listen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/listen" />
        </LinearLayout>
        <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stop" />
        <TextView android:id="@+id/stopwatch" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="28sp" android:textStyle="bold" android:gravity="center" android:visibility="gone" />
        <Button android:id="@+id/stopwatch_stop" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/stop_stopwatch" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/help" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/help" />
            <Button android:id="@+id/settings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
